{
  "$schema": "https://json.schemastore.org/package",
  "name": "andrew-github-profile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "vercel-build": "next build",
    "start": "next start",
    "dev": "next dev",
    "export": "next export",
    "info": "next info",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:hard": "yarn lint --fix && trunk check --fix --all",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write **/*.ts* --write **/**/*.ts*",
    "format:hard": "yarn format && trunk fmt --all",
    "update:png": "node ./scripts/generate-previews.mjs",
    "update:pdf": "node scripts/generate-resume-pdf.mjs --path /",
    "postupdate:png": "trunk check --filter=oxipng --fix --all",
    "prestart": "next build",
    "watch-type": "tsc --watch",
    "check-type": "tsc --noEmit"
  },
  "license": "MIT",
  "bin": "bin/next",
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@next/third-parties": "^16.1.1",
    "@octokit/core": "^7.0.6",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^169.0.0",
    "gray-matter": "^4.0.3",
    "lodash.groupby": "^4.6.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-github-calendar": "^5.0.4",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@headlessui/tailwindcss": "^0.2.1",
    "@next/eslint-plugin-next": "^16.1.1",
    "@octokit/types": "^16.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@trunkio/launcher": "^1.3.4",
    "@types/lodash.groupby": "^4.6.8",
    "@types/node": "25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.38",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer": "^24.34.0",
    "react-activity-calendar": "^3.0.5",
    "tailwind-merge": "^3.4.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  }
}
