{
  "$schema": "https://json.schemastore.org/package",
  "name": "andrew-github-profile",
  "version": "0.1.0",
  "scripts": {
    "vercel-build": "next build",
    "start": "next start",
    "dev": "next dev",
    "export": "next export",
    "info": "next info",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:hard": "yarn lint --fix && trunk check --fix --all",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write **/*.ts* --write **/**/*.ts*",
    "format:hard": "yarn format && trunk fmt --all",
    "update:png": "node ./scripts/generate-previews.mjs",
    "update:pdf": "node scripts/generate-resume-pdf.mjs --path /",
    "update:repos": "tsx scripts/update-repositories.ts",
    "postupdate:repos": "prettier --write --parser json data/repos/*.json",
    "prestart": "next build",
    "watch-type": "tsc --watch",
    "check-type": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@next/third-parties": "^16.2.11",
    "@octokit/core": "^7.0.6",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lodash.groupby": "^4.6.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-github-calendar": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@headlessui/tailwindcss": "^0.2.2",
    "@next/eslint-plugin-next": "^16.2.11",
    "@octokit/types": "^16.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash.groupby": "^4.6.9",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "puppeteer": "^25.3.0",
    "react-activity-calendar": "^3.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10",
    "wait-on": "^9.0.10"
  },
  "resolutions": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "js-yaml@npm:^3.13.1": "^3.15.0",
    "js-yaml@npm:^4.1.0": "^4.2.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "undici": "^7.28.0",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  },
  "packageManager": "yarn@4.17.0"
}
