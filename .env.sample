# Copy to .env and fill in. Never commit .env (it is gitignored).

# Required — GitHub PAT with repo read access (used by the repos/contributions
# GraphQL calls in src/lib/github and src/app/api/github/contributions).
GITHUB_TOKEN=

# Base origin the Puppeteer scripts (update:png / update:pdf) capture from.
# Defaults to http://localhost:3000 when unset; set to the production URL to
# capture against the deployed site.
PREVIEW_BASE_URL=http://localhost:3000

# Optional — set to 1 to launch Chromium with --no-sandbox (auto-enabled on CI).
# PUPPETEER_NO_SANDBOX=1

# Optional — timezone for the generated resume PDF (defaults to Asia/Seoul).
# TZ=Asia/Seoul
